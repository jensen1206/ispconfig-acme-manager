{
    "name": "harz-web24/ispconfig-dns-cert",
    "description": "Automatic Let's Encrypt DNS-01 certificate management for ISPConfig",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "symfony/console": "^7.4",
        "symfony/http-client": "^7.4",
        "symfony/process": "^7.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.88",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "fix": "php-cs-fixer fix",
        "lint": "parallel-lint src tests",
        "stan": "phpstan analyse",
        "rector": "rector process",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}