{
    "name": "jensen1206/ispconfig-acme-manager",
    "description": "Modern ACME certificate manager for ISPConfig with DNS-01 support.",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "ispconfig",
        "acme",
        "letsencrypt",
        "dns-01",
        "certificate",
        "ssl",
        "automation",
        "symfony",
        "php",
        "cli"
    ],
    "homepage": "https://github.com/jensen1206/ispconfig-acme-manager",
    "support": {
        "issues": "https://github.com/jensen1206/ispconfig-acme-manager/issues",
        "source": "https://github.com/jensen1206/ispconfig-acme-manager"
    },
    "authors": [
        {
            "name": "Jens Wiecker",
            "homepage": "https://wiecker.eu",
            "role": "Maintainer"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/jensen1206/ispconfig-acme-manager.git"
        }
    ],
    "require": {
        "php": "^8.2",
        "symfony/console": "^7.4",
        "symfony/http-client": "^7.4",
        "symfony/process": "^7.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.88",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "fix": "php-cs-fixer fix",
        "lint": "parallel-lint src tests bin",
        "stan": "phpstan analyse",
        "rector": "rector process",
        "test": "phpunit --do-not-fail-on-empty-test-suite",
        "check": [
            "@lint",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
