#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Acme\AcmeManager;
use App\Certificate\CertificateFactory;
use App\Command\DoctorCommand;
use App\Command\IssueCertificateCommand;
use App\Command\PreviewCertificateCommand;
use App\Config\Configuration;
use App\ISPConfig\ApiClient;
use App\ISPConfig\WebsiteRepository;
use App\Process\ProcessRunner;
use App\Service\CertificateService;
use App\Service\DoctorService;
use Symfony\Component\Console\Application;
use Symfony\Component\HttpClient\HttpClient;
use App\ISPConfig\WebsiteUpdater;
use App\Command\UpdateWebsiteCommand;
use App\ISPConfig\ClientIdResolver;
use App\Command\UpdateDebugCommand;
use App\Certificate\CertificateReader;
use App\Command\VerifyCertificateCommand;
use App\Service\CertificateVerificationService;

require dirname(__DIR__) . '/vendor/autoload.php';

$configuration = Configuration::fromFile(
        '/etc/ispconfig-dns-cert.php',
);

$apiClient = new ApiClient(
        httpClient: HttpClient::create(),
        configuration: $configuration,
);

$processRunner = new ProcessRunner();

$websiteRepository = new WebsiteRepository(
        apiClient: $apiClient,
);

$certificateFactory = new CertificateFactory();

$acmeManager = new AcmeManager(
        configuration: $configuration,
        processRunner: $processRunner,
);



$doctorService = new DoctorService(
        configuration: $configuration,
        apiClient: $apiClient,
        processRunner: $processRunner,
);

$clientIdResolver = new ClientIdResolver(
    apiClient: $apiClient,
);

$websiteUpdater = new WebsiteUpdater(
    apiClient: $apiClient,
    clientIdResolver: $clientIdResolver,
);

$certificateReader = new CertificateReader();

$certificateVerificationService = new CertificateVerificationService(
    websiteRepository: $websiteRepository,
    certificateFactory: $certificateFactory,
    certificateReader: $certificateReader,
);

$certificateService = new CertificateService(
    websiteRepository: $websiteRepository,
    certificateFactory: $certificateFactory,
    acmeManager: $acmeManager,
    websiteUpdater: $websiteUpdater,
    verificationService: $certificateVerificationService,
);

$application = new Application(
        name: 'ISPConfig DNS Certificate Manager',
        version: '0.3.0',
);

$application->add(
        new PreviewCertificateCommand(
                certificateService: $certificateService,
                apiClient: $apiClient,
        ),
);

$application->add(
        new IssueCertificateCommand(
                certificateService: $certificateService,
                apiClient: $apiClient,
        ),
);

$application->add(
        new DoctorCommand(
                doctorService: $doctorService,
        ),
);

$application->add(
    new UpdateDebugCommand(
        websiteRepository: $websiteRepository,
        certificateFactory: $certificateFactory,
        websiteUpdater: $websiteUpdater,
        apiClient: $apiClient,
    ),
);

$application->add(
    new UpdateWebsiteCommand(
        websiteRepository: $websiteRepository,
        certificateFactory: $certificateFactory,
        websiteUpdater: $websiteUpdater,
        apiClient: $apiClient,
    ),
);

$application->add(
    new VerifyCertificateCommand(
        verificationService: $certificateVerificationService,
        apiClient: $apiClient,
    ),
);



exit($application->run());
